# Public settings only. Fixture is accepted in development/explicit UI preview only.
VITE_DATA_MODE=fixture

# Optional public Firebase Web config. Leave blank to disable browser push registration.
# NEVER put service-account JSON, private keys or backend credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Gateway mode for the local demo against the real backend (see README / HUONG_DAN_BUILD_VA_CHAY_DEMO_1.md).
# VITE_DATA_MODE=gateway
# For paired demo worktrees, set this in .env.demo.local (relative to the Web root).
# WOLFARI_DEMO_BACKEND_ROOT=../Wolfari-backend-demo-2
# Match the Automation service when selecting its fare source explicitly.
# VITE_PRICE_WATCH_PROVIDER=SEARCHAPI_GOOGLE_FLIGHTS
# Browser-restricted Geoapify key for map tiles (https://myprojects.geoapify.com). Leave empty to
# show "Bản đồ nền chưa khả dụng"; place search and lists still work. Never commit a real key.
VITE_GEOAPIFY_BROWSER_KEY=
