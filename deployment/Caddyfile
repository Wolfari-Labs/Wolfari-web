{
	# No debug/access logging: auth/invitation query strings contain tokens.
	admin localhost:2019
}

wolfari.thepiece.io.vn {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	route {
		@private path /api/v1/auth/local /api/v1/auth/local/* /invitations/local /invitations/local/* /internal /internal/* /health /health/* /.env /.git/*
		respond @private 404
		@api path /api/v1 /api/v1/*
		handle @api {
			request_body {
				max_size 12MB
			}
			header Cache-Control "no-store"
			reverse_proxy 127.0.0.1:3000 {
				header_up X-Real-IP {http.request.remote.host}
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}
		@unknownApi path /api /api/*
		handle @unknownApi {
			respond 404
		}
		handle {
			root * /srv/wolfari/current/Wolfari-web/dist-deploy
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
